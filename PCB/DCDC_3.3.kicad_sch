	(text "(3.3-1.6)/5.6=0.3mA"
		(exclude_from_sim no)
		(at 213.36 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3d074004-7c4d-49f5-9d2e-3d2edffd2f12")
	)
	(text "1N4148WS can be replaced with schottky to reduce bom.  \n1N5819WS will leak <1mA at high temp which \npushes against internal esd protection of LV2842 \nand as expected results in -0.4V on BATT_Diode"
		(exclude_from_sim no)
		(at 103.378 60.452 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3d47bfc9-baa0-41ed-8233-f3324ae80a1a")
	)
	(text "Calculate resistors for undervoltage cutout:\nI_{1} = 1uA\nI_{Hyst}=3uA\nV_{Ena} = 1.25V  (1.05...1.38)\n\nAssume typical V_{Ena} = 1.2V:\nR1 = (V_{start} - V_{stop})/I_{Hyst}\nR1 = (11V - 9) / 3uA = 100kOhm // don't care about hysteresis anyway\nR2 = V_{Ena} / ((V_{start} - V_{Ena})/R1+I_{1})\nR2_{rounded} = 1.2V / ((7.1V-1.2V)/100kOhm + 1uA) = 20kOhm\n\nThere is a diode in series\nD1_V{F}_ON = 0.8\nD1_V{F}_OFF = 0.5\nso actual threshold is:\nV_{stop_real} = V_{stop}+D1_V{F}_ON\nV_{start_real} = V_{start}+D1_V{F}_OFF\nV_{stop_real} = 6.5 + 0.8 = 7.3V\nV_{start_real} = 7.1 + 0.4 = 7.5V"
		(exclude_from_sim no)
		(at 25.654 176.276 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "54981c22-c5b4-4d50-b15d-461ac161c4a6")
	)
	(text "I0= 0.1A (minimum typical)\n\nL0 = (30-3)/(0.1*.3)*3/30/1.1  = 82uH\nIripple = 3 *(30-3)/30 / 82 / 1.1 = 0.03A\nIl-rms = sqrt((82*10^-6)^2+1/12*0.03^2) = 0.0086A\nIL-peak = 0.2 + 0.061/2 = 0.23\n\n"
		(exclude_from_sim no)
		(at 149.86 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8b0c5e47-8114-4dde-9e82-1e181b4f0645")
	)
	(text "Remove R49 to force always enable"
		(exclude_from_sim no)
		(at 102.616 172.974 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8f23f6f9-2af4-423f-9eb4-dfc5c37b39c4")
	)
	(text "High (IPU) = ON\nLow = OFF\nEnable Threshold voltage:\n1.05(min) 1.25(typ) 1.38V(max)"
		(exclude_from_sim no)
		(at 116.84 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9a75ad5f-4356-4476-85ab-652b091886c4")
	)
	(text "VOUT = 0.765V (1+(R1/R2))=3.366V"
		(exclude_from_sim no)
		(at 149.86 104.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cfbd4d25-4ccb-4965-91fe-e555aee17572")
	)
